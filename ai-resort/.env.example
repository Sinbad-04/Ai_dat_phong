# ============ LLM (mặc định: ckey.vn) ============
# ckey.vn là API OpenAI-compatible. Lấy key tại https://ckey.vn (Open Console).
# Để TRỐNG mọi key -> app chạy "demo mode" (trả lời mẫu dựa trên tri thức).
LLM_PROVIDER=ckey                 # ckey | anthropic | openai
CKEY_API_KEY=
CKEY_BASE_URL=https://api.xah.io/v1
CKEY_MODEL=gpt-4o-mini            # đổi sang model bất kỳ trong console ckey (gpt/claude/gemini...)

# (Tuỳ chọn) gọi thẳng provider khác
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============ Database (Postgres) ============
# Local: postgres://user:pass@localhost:5432/resort
# Neon/Supabase/Vercel: dán connection string vào đây
# Để TRỐNG khi dev nhanh -> app tự dùng bộ nhớ tạm (in-memory, KHÔNG bền vững).
DATABASE_URL=

# ============ Auth ============
# Chuỗi bí mật ký JWT. Tạo bằng: openssl rand -base64 32
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai

# Tài khoản admin được seed tự động lần đầu chạy
ADMIN_EMAIL=admin@resort.vn
ADMIN_PASSWORD=Admin@12345

# ============ LiteAPI (dữ liệu khách sạn thật + thanh toán hosted) ============
# Lấy key tại https://dashboard.liteapi.travel (Free Signup). Sandbox key có tiền tố sand_.
# Để TRỐNG -> trang /hotels tự fallback dữ liệu mẫu của An Lành Bay.
LITEAPI_API_KEY=
LITEAPI_ENV=sandbox               # sandbox | production (phải khớp loại key)

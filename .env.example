# LLM provider: ckey, openai, or anthropic
LLM_PROVIDER=ckey

CKEY_API_KEY=
CKEY_BASE_URL=https://api.xah.io/v1
CKEY_MODEL=gpt-5.4

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Application
DATABASE_URL=
APP_TIME_ZONE=Asia/Ho_Chi_Minh
JWT_SECRET=
ADMIN_EMAIL=admin@resort.vn
ADMIN_PASSWORD=

# Bank transfer details shown in the UI
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_HOLDER=

# Transactional email
RESEND_API_KEY=
EMAIL_FROM=

# Hotel inventory
LITEAPI_API_KEY=
LITEAPI_ENV=sandbox
